# 不纳入版本库的文件

# 依赖与缓存
node_modules/
.vite/

# ============================================================
# 原图（40MB 级、长边 6000-8000px）绝不进仓库
# 仓库里只放 images/ 下压缩过的图（长边 ≤1800px）和 thumbs/ 缩略图（800px）
# 下面这些"放原图的地方"一律忽略；它们通常位于仓库外的桌面上
# ============================================================
raw/
rawcn/
椰青/
原始/
原图/
来源/
备份/

# 原始照片格式
*.cr2
*.cr3
*.nef
*.arw
*.dng
*.raf
*.orf
*.rw2
*.psd
*.psb
*.tif
*.tiff
*.heic
*.bmp

# 压缩包（打包的原图常是 zip）
*.zip
*.7z
*.rar

# 系统 / 编辑器
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# 临时文件
*.tmp
*.log

# 由 tools/bundle-for-review.mjs 生成（源码副本，会随源码漂移，不入库）
docs/给GPT-源码包-可粘贴.md

# 数据管线临时下载缓存（GRIB2 原文件，绝不入库）
.cache/

# Python 字节码缓存
__pycache__/
*.pyc

# Vite 产物不进仓库（2026-11-05 起）。
# 线上由 Cloudflare Pages 跑 npm run build 生成 dist/ 再发布，
# 仓库里只要源码；本地跑一次 build 就能拿到。
# 曾经把 dist/ 提交进仓库，每次构建都产生几十个带哈希的新文件，历史又大又全是噪音。
dist/
dist/*

# 根目录的 HTML 与 assets/ 是「构建中间产物」（2026-11-07 起不跟踪）。
# 根目录 *.html 由 prebuild 的 tools/restore-shells.mjs 从 src/shells/ 复制生成，
# 仅供 vite 当 rollup 入口用；assets/ 曾由已移除的 tools/publish-root.ts 写回。
# 线上发布的是 dist/（线上实测确认），所以这些都不该进 Git。
# 注意：/*.html 只匹配根目录，不影响 src/shells/*.html（那些才是源文件，必须跟踪）。
/*.html
/assets/

# 验证脚本的截图产物（可随时重新生成，不入库）
tools/obs/out/

# 一次性分析/扫描脚本（2026-11-07 起）。
# 约定见 docs/ALGORITHM-COLLAB.md 第六节规则 8：临时脚本用 _tmp- 前缀，不进正式工具列表。
# 这些脚本的结论应写进文档（docs/analysis/ 或台账），脚本本身用完即删。
tools/_tmp-*.mjs
